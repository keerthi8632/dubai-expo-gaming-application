# Database (Neon / Supabase Postgres connection string)
DATABASE_URL="postgresql://user:password@host:5432/mh_markets_expo"

# Admin auth
JWT_SECRET="replace-with-a-long-random-string"
ADMIN_SEED_EMAIL="admin@mhmarkets.com"
ADMIN_SEED_PASSWORD="replace-with-a-strong-password"

# Email OTP (Resend)
RESEND_API_KEY="re_xxxxxxxxxxxx"
RESEND_FROM_EMAIL="MH Markets <noreply@yourdomain.com>"

# SMS OTP (Twilio) - optional if you go email-only, see note in README
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="xxxxxxxxxxxx"
TWILIO_VERIFY_SERVICE_SID="VAxxxxxxxxxxxx"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
OTP_EXPIRY_MINUTES="5"
