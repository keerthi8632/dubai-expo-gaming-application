# Database (SQLite — single file on disk, good fit for a booth running on one
# machine that both kiosk screens connect to). Use a Postgres URL instead
# (e.g. "postgresql://user:password@host:5432/db") if deploying to a
# serverless host, where a local file won't persist reliably.
DATABASE_URL="file:./dev.db"

# Admin auth
JWT_SECRET="replace-with-a-long-random-string"
ADMIN_SEED_EMAIL="admin@mhmarkets.com"
ADMIN_SEED_PASSWORD="Gaming@543211"

# Email OTP (Resend)
RESEND_API_KEY="re_xxxxxxxxxxxx"
RESEND_FROM_EMAIL="MH Markets <noreply@yourdomain.com>"

# SMS OTP (Twilio) - optional if you go email-only, see note in README
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="xxxxxxxxxxxx"
TWILIO_VERIFY_SERVICE_SID="VAxxxxxxxxxxxx"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
OTP_EXPIRY_MINUTES="5"
