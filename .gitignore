# dependencies
/node_modules

# next.js build output
/.next/
/out/
/build

# testing/coverage
/coverage

# env files (never commit secrets)
.env
.env*.local

# SQLite databases (local data, don't commit real participant records) —
# covers dev.db (local dev) and prod.db (production, kept separate on purpose)
/prisma/*.db
/prisma/*.db-journal
/prisma/*.db-wal
/prisma/*.db-shm

# typescript
*.tsbuildinfo
next-env.d.ts

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# editor/OS junk
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# vercel
.vercel
